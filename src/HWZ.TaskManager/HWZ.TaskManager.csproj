<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HWZ.TaskManager</AssemblyName>
    <RootNamespace>HWZ.TaskManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Authors>HWZ</Authors>
    <Company>HWZ</Company>
    <Product>HWZ Windows Task Manager</Product>
    <AssemblyTitle>HWZ Windows Task Manager</AssemblyTitle>
    <Description>一款现代、轻量的 Windows 任务管理器。</Description>
    <Copyright>Copyright © 2026 HWZ</Copyright>
    <RepositoryUrl>https://github.com/HWZ-ch/HWZ_Windows_TaskManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
