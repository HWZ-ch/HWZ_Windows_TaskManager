<Window x:Class="HWZ.TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HWZ.TaskManager.Views"
        Title="HWZ Windows Task Manager"
        Width="1380"
        Height="880"
        MinWidth="1120"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding Settings.AlwaysOnTop}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="22,28,16,26">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="12"
                            Background="{DynamicResource LogoGradientBrush}">
                        <Path Data="{StaticResource IconBolt}"
                              Width="19"
                              Height="19"
                              Fill="{DynamicResource OnAccentBrush}"
                              Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HWZ"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="5"
                                    Padding="5,1.5"
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="TASK"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="WINDOWS TASK MANAGER"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="工作区"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="12,0,0,8" />

                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             AutomationProperties.Name="主导航"
                             ItemsSource="{Binding NavItems}"
                             SelectedValuePath="Key"
                             SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                             Style="{StaticResource NavListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{Binding IconData}"
                                          Width="17"
                                          Height="17"
                                          VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2" Margin="16,8,16,20">
                    <Border Background="{DynamicResource SurfaceInsetBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="13,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse Width="18" Height="18">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessSoftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="7" Height="7">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding LiveStatusText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="4,13,4,0">
                        <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="本地采集 · 数据不出设备"
                                   HorizontalAlignment="Right"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main surface -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid IsHitTestVisible="False">
                <Ellipse Width="690"
                         Height="690"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-370,-240,0"
                         Fill="{DynamicResource AmbientAccentBrush}" />
                <Ellipse Width="560"
                         Height="560"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-260,0,0,-310"
                         Fill="{DynamicResource AmbientVioletBrush}" />
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0">
                            <TextBlock Text="实时系统控制台"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="/"
                                       FontSize="11"
                                       Margin="9,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Opacity="0.55" />
                            <TextBlock Text="{Binding PageTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                        <Border CornerRadius="7"
                                Padding="9,4"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LiveStatusText}"
                                           FontSize="10"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="27"
                                Padding="10,3"
                                Margin="0,0,7,0"
                                FontSize="10.5"
                                VerticalAlignment="Center"
                                Command="{Binding ShowUpdatePageCommand}"
                                Visibility="{Binding IsUpdateIndicatorVisible, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="查看可用更新"
                                AutomationProperties.Name="查看可用更新">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}"
                                      Width="11"
                                      Height="11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0" />
                                <TextBlock Text="{Binding UpdateBadgeText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="立即刷新 (F5)"
                                AutomationProperties.Name="立即刷新">
                            <Path Data="{StaticResource IconRefresh}"
                                  Width="15"
                                  Height="15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding TogglePauseCommand}"
                                ToolTip="{Binding PauseButtonText}"
                                AutomationProperties.Name="{Binding PauseButtonText}">
                            <Grid Width="15" Height="15">
                                <Path Data="{StaticResource IconPause}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource IconPlay}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="切换明暗主题"
                                AutomationProperties.Name="切换明暗主题">
                            <Path Data="{StaticResource IconTheme}"
                                  Width="15"
                                  Height="15"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" />
                        </Button>

                        <Border Width="1"
                                Height="18"
                                Background="{DynamicResource DividerBrush}"
                                Margin="7,0" />

                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="最小化"
                                AutomationProperties.Name="最小化">
                            <Path Data="{StaticResource IconMinimize}"
                                  Width="11"
                                  Height="11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="最大化"
                                AutomationProperties.Name="最大化">
                            <Path x:Name="MaximizeIcon"
                                  Data="{StaticResource IconMaximize}"
                                  Width="10"
                                  Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="关闭"
                                AutomationProperties.Name="关闭">
                            <Path Data="{StaticResource IconClose}"
                                  Width="10"
                                  Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Pages -->
                <Grid Grid.Row="1" Margin="32,2,32,24">
                    <views:OverviewView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=overview}" />
                    <views:ProcessesView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=processes}" />
                    <views:PerformanceView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=performance}" />
                    <views:StartupView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=startup}" />
                    <views:ServicesView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=services}" />
                    <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=settings}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border Grid.Column="1"
                Panel.ZIndex="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,26"
                MaxWidth="470"
                CornerRadius="11"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="14,11"
                IsHitTestVisible="False"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Direction="270"
                                  Opacity="0.36"
                                  ShadowDepth="8"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="27"
                        Height="27"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Width="13"
                          Height="13"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="{x:Type Path}">
                                <Setter Property="Data" Value="{StaticResource IconCheck}" />
                                <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconWarning}" />
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding ToastMessage}"
                           Margin="11,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
