<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowColor">#F1F4F9</Color>
    <Color x:Key="SidebarColor">#FAFBFD</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F7F9FC</Color>
    <Color x:Key="SurfaceInsetColor">#F5F7FB</Color>
    <Color x:Key="SurfaceHoverColor">#F0F4FA</Color>
    <Color x:Key="CardBorderColor">#E3E9F1</Color>
    <Color x:Key="DividerColor">#EDF1F6</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#5B6B80</Color>
    <Color x:Key="TextTertiaryColor">#8A9AAE</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="Accent2Color">#7C3AED</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="InfoColor">#0284C7</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardBorderSoftBrush" Color="#EDF1F7" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#162563EB" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="VioletSoftBrush" Color="#167C3AED" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#16059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#18D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#15DC2626" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D9E2ED" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#BECBDB" />
    <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#F0F4FA" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E9EEF6" />
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#E8EEF7" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#100F172A" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#0C000000" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#330F172A" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#0A0F172A" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F1F5FB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#552563EB" />
    <SolidColorBrush x:Key="ToggleSwitchOffBrush" Color="#CDD8E5" />
    <SolidColorBrush x:Key="ToggleSwitchThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9AA8BA" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#4D0F172A" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#E9F0FF" />

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#6D5BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFD" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D2563EB" Offset="0" />
        <GradientStop Color="#007C3AED" Offset="0.6" />
        <GradientStop Color="#0B7C3AED" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AmbientAccentBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1A2563EB" Offset="0" />
        <GradientStop Color="#0A2563EB" Offset="0.55" />
        <GradientStop Color="#002563EB" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#147C3AED" Offset="0" />
        <GradientStop Color="#077C3AED" Offset="0.58" />
        <GradientStop Color="#007C3AED" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
