<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowColor">#080C12</Color>
    <Color x:Key="SidebarColor">#0A0F16</Color>
    <Color x:Key="SurfaceColor">#111823</Color>
    <Color x:Key="SurfaceRaisedColor">#151E2A</Color>
    <Color x:Key="SurfaceInsetColor">#0C131C</Color>
    <Color x:Key="SurfaceHoverColor">#182333</Color>
    <Color x:Key="CardBorderColor">#1E2B3B</Color>
    <Color x:Key="DividerColor">#182331</Color>
    <Color x:Key="TextPrimaryColor">#F2F6FC</Color>
    <Color x:Key="TextSecondaryColor">#95A3B8</Color>
    <Color x:Key="TextTertiaryColor">#64748B</Color>
    <Color x:Key="AccentColor">#4D8DFF</Color>
    <Color x:Key="AccentHoverColor">#70A5FF</Color>
    <Color x:Key="Accent2Color">#8B5CF6</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#FB7185</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardBorderSoftBrush" Color="#141E2B" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E4D8DFF" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="VioletSoftBrush" Color="#2E8B5CF6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2934D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2AFBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#30FB7185" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0B121B" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#243244" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#31435A" />
    <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#1A2534" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1B2736" />
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#1D2A3C" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#1B2634" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5A4D8DFF" />
    <SolidColorBrush x:Key="ToggleSwitchOffBrush" Color="#2D3B4F" />
    <SolidColorBrush x:Key="ToggleSwitchThumbBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#55657B" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#B3070B11" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#141F2D" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#244D8DFF" />

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4D8DFF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4D8DFF" Offset="0" />
        <GradientStop Color="#7069FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#151E2A" Offset="0" />
        <GradientStop Color="#101722" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A4D8DFF" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="0.6" />
        <GradientStop Color="#108B5CF6" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AmbientAccentBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#254D8DFF" Offset="0" />
        <GradientStop Color="#114D8DFF" Offset="0.55" />
        <GradientStop Color="#004D8DFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1F8B5CF6" Offset="0" />
        <GradientStop Color="#0C8B5CF6" Offset="0.58" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
