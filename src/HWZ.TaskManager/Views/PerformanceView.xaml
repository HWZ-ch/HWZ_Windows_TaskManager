<UserControl x:Class="HWZ.TaskManager.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HWZ.TaskManager.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="LegendTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="StatValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,10,0,14">

            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="性能" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="深入查看系统资源随时间的变化，及时发现性能瓶颈。"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LiveStatusText}" FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceInsetBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5">
                        <TextBlock Text="{Binding HistoryWindowText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinHeight="278">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="处理器" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="总体 CPU 使用率"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="15,3,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuSubtitleText}"
                                       HorizontalAlignment="Right"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0.0}%}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Margin="14,6,0,0">
                                <TextBlock Text="{Binding CpuNameText}"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="280" />
                                <TextBlock Text="{Binding RefreshRateText}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <controls:SparklineChart Grid.Row="2"
                                                 Height="102"
                                                 Margin="0,7,0,5"
                                                 Values="{Binding CpuHistory}"
                                                 AccentBrush="{DynamicResource AccentBrush}"
                                                 GridBrush="{DynamicResource ChartGridBrush}"
                                                 MinimumRange="20" />

                        <Grid Grid.Row="3" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="线程" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding ThreadsText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="句柄" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding HandlesText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="进程" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding ProcessCount}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Memory chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" MinHeight="278">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource VioletBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="内存" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="物理内存使用情况"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="15,3,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding MemoryTotalText}"
                                       HorizontalAlignment="Right"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0.0}%}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VioletBrush}" />
                            <StackPanel Margin="14,6,0,0">
                                <TextBlock FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding MemoryUsedText, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding MemoryTotalText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding MemoryAvailableText, StringFormat=可用 {0}}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <controls:SparklineChart Grid.Row="2"
                                                 Height="102"
                                                 Margin="0,7,0,5"
                                                 Values="{Binding MemoryHistory}"
                                                 AccentBrush="{DynamicResource VioletBrush}"
                                                 GridBrush="{DynamicResource ChartGridBrush}"
                                                 MinimumRange="20" />

                        <Grid Grid.Row="3" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="已提交" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding CommitText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="缓存/可用" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding MemoryAvailableText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="内存总量" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding MemoryTotalText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Disk chart -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" MinHeight="278">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="磁盘" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="物理磁盘读写吞吐"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="15,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="读取" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <TextBlock Text="写入" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                            <StackPanel>
                                <TextBlock Text="读取" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding DiskReadText}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="26,0,0,0">
                                <TextBlock Text="写入" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding DiskWriteText}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InfoBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <controls:SparklineChart Grid.Row="2"
                                                 Height="102"
                                                 Margin="0,7,0,5"
                                                 Values="{Binding DiskReadHistory}"
                                                 Values2="{Binding DiskWriteHistory}"
                                                 AccentBrush="{DynamicResource WarningBrush}"
                                                 Accent2Brush="{DynamicResource InfoBrush}"
                                                 GridBrush="{DynamicResource ChartGridBrush}"
                                                 MinimumRange="2" />

                        <Grid Grid.Row="3" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="总吞吐" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding DiskThroughputText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="总体磁盘占用" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding OverallDiskUsedPercentText}" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Network chart -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="278">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="网络" Style="{StaticResource CardTitleStyle}" />
                                </StackPanel>
                                <TextBlock Text="实时网络吞吐"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="15,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="下载" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <TextBlock Text="上传" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,4">
                            <StackPanel>
                                <TextBlock Text="下载" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding NetworkDownText}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="26,0,0,0">
                                <TextBlock Text="上传" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding NetworkUpText}"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <controls:SparklineChart Grid.Row="2"
                                                 Height="102"
                                                 Margin="0,7,0,5"
                                                 Values="{Binding NetworkDownHistory}"
                                                 Values2="{Binding NetworkUpHistory}"
                                                 AccentBrush="{DynamicResource SuccessBrush}"
                                                 Accent2Brush="{DynamicResource AccentBrush}"
                                                 GridBrush="{DynamicResource ChartGridBrush}"
                                                 MinimumRange="1" />

                        <Grid Grid.Row="3" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="活动网络" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding ActiveNetworkName}"
                                           Style="{StaticResource StatValueStyle}"
                                           HorizontalAlignment="Left"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="地址" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding ActiveNetworkAddress}"
                                           Style="{StaticResource StatValueStyle}"
                                           HorizontalAlignment="Left"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="链接速度" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding ActiveNetworkLinkSpeed}"
                                           Style="{StaticResource StatValueStyle}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Lower detail cards -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="磁盘卷" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding OverallDiskUsedText}"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,13">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="28" Height="28" Margin="0,0,10,0">
                                            <Border Background="{Binding AvatarBrush}" CornerRadius="7" Opacity="0.9" />
                                            <Path Data="M5,4 H19 V20 H5 Z M8,8 H16 M8,12 H16 M8,16 H13"
                                                  Width="13"
                                                  Height="13"
                                                  Stroke="White"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UsedText}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UsedPercentText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <ProgressBar Grid.Row="1"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="2"
                                                     Style="{StaticResource ThinProgressBarStyle}"
                                                     Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Margin="0,6,0,0"
                                                     Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="未发现可用的磁盘卷"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasVolumes, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="网络适配器" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding NetworkAdapters.Count, StringFormat={}{0} 个活动连接}"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NetworkAdapters}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceInsetBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="11,9"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TypeText}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Address}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="  ·  " FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding DownText, StringFormat=↓ {0}}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="  " />
                                                <TextBlock Text="{Binding UpText, StringFormat=↑ {0}}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="未检测到活动网络适配器"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasNetworkAdapters, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="图表保留最近 60 个采样点。所有数据均在本地实时采集，不会离开此设备。"
                       FontSize="9.5"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="2,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
