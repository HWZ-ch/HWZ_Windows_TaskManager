<UserControl x:Class="HWZ.TaskManager.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,10,0,14">

            <Grid Margin="0,0,0,17">
                <StackPanel>
                    <TextBlock Text="启动应用" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding StartupSummaryText}"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Margin="0,0,9,0"
                            AutomationProperties.Name="系统启动设置"
                            Command="{Binding OpenStartupSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExternal}"
                                  Width="12"
                                  Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,7,0" />
                            <TextBlock Text="系统启动设置" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="36"
                            Height="36"
                            Command="{Binding RefreshStartupManuallyCommand}"
                            ToolTip="重新扫描启动项"
                            AutomationProperties.Name="重新扫描启动项">
                        <Path Data="{StaticResource IconRefresh}"
                              Width="14"
                              Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid Width="310" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Height="34"
                             Padding="35,0"
                             AutomationProperties.Name="搜索启动项"
                             Tag="搜索启动项、发布者或路径"
                             Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Data="{StaticResource IconSearch}"
                          Width="14"
                          Height="14"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="13,0,0,0"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          IsHitTestVisible="False" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="7" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}"
                                  Width="11"
                                  Height="11"
                                  Stroke="{DynamicResource WarningBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="只读视图，禁用请前往系统设置"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="正在扫描启动项…"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLoadingStartup, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,14"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="登录启动项" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="登录 Windows 时自动运行的应用与服务入口"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding StartupCount, Mode=OneWay}" />
                                    <Run Text=" 项" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StartupView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                                            <Border Background="{Binding AvatarBrush}" CornerRadius="9" />
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding IconSource}"
                                                   Width="25"
                                                   Height="25"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CommandDisplay}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"
                                                       ToolTip="{Binding Command}" />
                                            <TextBlock Text="{Binding FriendlyPublisher, StringFormat=发布者：{0}}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource SurfaceInsetBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                            <TextBlock Text="{Binding SourceShort}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>

                                        <Button Grid.Column="3"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Height="30"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="打开启动项位置"
                                                Command="{Binding DataContext.OpenStartupLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Command}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFolder}"
                                                      Width="12"
                                                      Height="12"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />
                                                <TextBlock Text="打开位置" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceInsetBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="14,11"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconShield}"
                          Width="15"
                          Height="15"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="关于启动项管理"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="启动项会影响开机速度。HWZ 任务管理器只读取这些项目，不会擅自修改系统启动配置。"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="前往设置"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding OpenStartupSettingsCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
