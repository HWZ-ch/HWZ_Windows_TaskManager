<UserControl x:Class="HWZ.TaskManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,10,0,14">

            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="调整外观、监控频率与交互偏好。所有设置都会自动保存。"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Border Background="{DynamicResource SurfaceInsetBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}"
                              Width="10"
                              Height="10"
                              Stroke="{DynamicResource SuccessBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0" />
                        <TextBlock Text="自动保存已开启" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="外观" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="选择你喜欢的窗口配色。"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="APPEARANCE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <ListBox ItemsSource="{Binding ThemeOptions}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding Settings.ThemeMode, Mode=TwoWay}"
                                     Style="{StaticResource OptionChipListBoxStyle}"
                                     AutomationProperties.Name="界面主题"
                                     Margin="0,16,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,13" />

                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="深色主题适合长时间查看系统指标，能减少视觉疲劳。" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.ThemeMode}" Value="Light">
                                                <Setter Property="Text" Value="浅色主题提供明亮、清晰的阅读体验，适合光线充足的环境。" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Settings.ThemeMode}" Value="System">
                                                <Setter Property="Text" Value="自动跟随 Windows 的应用主题设置，在启动时读取系统偏好。" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="监控" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="控制数据采集与刷新的节奏。"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="刷新频率"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,0" />
                            <TextBlock Text="频率越高，数据越实时，资源开销也会略微增加。"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,3,0,9"
                                       TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding RefreshOptions}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding Settings.RefreshSeconds, Mode=TwoWay}"
                                     Style="{StaticResource OptionChipListBoxStyle}"
                                     AutomationProperties.Name="刷新频率">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="窗口置顶" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="让 HWZ 任务管理器始终显示在其他窗口上方。"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.AlwaysOnTop, Mode=TwoWay}"
                                          AutomationProperties.Name="窗口置顶"
                                          VerticalAlignment="Center"
                                          Margin="14,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="操作与安全" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="减少误操作，保持操作体验顺手。"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="SAFETY" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="结束任务前确认" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="在结束进程或进程树之前请求确认，避免误点。"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.ConfirmOnEnd, Mode=TwoWay}"
                                          AutomationProperties.Name="结束任务前确认"
                                          VerticalAlignment="Center"
                                          Margin="14,0,0,0" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="显示进程图标" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="从可执行文件中提取图标；关闭后可降低列表加载开销。"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.ShowProcessIcons, Mode=TwoWay}"
                                          AutomationProperties.Name="显示进程图标"
                                          VerticalAlignment="Center"
                                          Margin="14,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="{DynamicResource LogoGradientBrush}">
                                    <Path Data="{StaticResource IconBolt}"
                                          Width="22"
                                          Height="22"
                                          Fill="{DynamicResource OnAccentBrush}"
                                          Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="13,1,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="HWZ" FontFamily="{StaticResource DisplayFontFamily}" FontSize="19" FontWeight="Bold" />
                                    <TextBlock Text="WINDOWS TASK MANAGER"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="一款现代、轻量的 Windows 任务管理器。以简洁的界面呈现完整的系统状态，并提供可靠的进程、服务与启动项管理。"
                                       FontSize="10.5"
                                       LineHeight="17"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="7,3" Margin="0,0,5,0">
                                    <TextBlock Text="WPF" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border Background="{DynamicResource VioletSoftBrush}" CornerRadius="5" Padding="7,3" Margin="0,0,5,0">
                                    <TextBlock Text=".NET 10" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}" />
                                </Border>
                                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="5" Padding="7,3">
                                    <TextBlock Text="本地运行" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,17,0,13" />

                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="版本" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="技术栈" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="WPF · .NET 10"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="运行环境" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding SystemInfo.DotNetVersion}"
                                           HorizontalAlignment="Right"
                                           FontSize="9.5"
                                           MaxWidth="185"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           ToolTip="{Binding SystemInfo.DotNetVersion}" />
                            </Grid>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36"
                                    Margin="0,17,0,0"
                                    AutomationProperties.Name="在 GitHub 上查看"
                                    Command="{Binding OpenRepositoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExternal}"
                                          Width="12"
                                          Height="12"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="在 GitHub 上查看" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="github.com/HWZ-ch/HWZ_Windows_TaskManager"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="使用提示" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="几个让使用更顺手的小细节。"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,4,0,13" />

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconChevronRight}"
                                      Width="10"
                                      Height="10"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="0,3,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="在进程页双击任意一行，即可查看完整的进程详情。"
                                           FontSize="10"
                                           LineHeight="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconChevronRight}"
                                      Width="10"
                                      Height="10"
                                      Stroke="{DynamicResource WarningBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="0,3,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Windows 核心进程受到保护，避免误操作导致系统不稳定。"
                                           FontSize="10"
                                           LineHeight="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconChevronRight}"
                                      Width="10"
                                      Height="10"
                                      Stroke="{DynamicResource SuccessBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="0,3,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="服务操作通常需要管理员身份，失败时请检查当前权限。"
                                           FontSize="10"
                                           LineHeight="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconChevronRight}"
                                      Width="10"
                                      Height="10"
                                      Stroke="{DynamicResource VioletBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="0,3,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="快捷键：Ctrl+1–6 切换页面，F5 刷新，Ctrl+P 暂停，Ctrl+T 切换主题。"
                                           FontSize="10"
                                           LineHeight="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceInsetBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="14,11"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="隐私优先" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock Text="监控数据只在本机内存中处理，不会上传。仅在发生异常时写入本地错误日志，便于排查问题。"
                                       FontSize="9.5"
                                       LineHeight="15"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="HWZ Windows Task Manager · 为 Windows 10 / 11 打造 · 本地数据"
                       FontSize="9"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,2" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
