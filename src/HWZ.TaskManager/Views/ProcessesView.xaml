<UserControl x:Class="HWZ.TaskManager.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RightHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="12,0,22,0" />
        </Style>

        <Style x:Key="NumericCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="KindPillStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="进程" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource PageSubtitleStyle}">
                    <Run Text="{Binding ProcessCount, Mode=OneWay}" />
                    <Run Text=" 个进程正在运行 · " />
                    <Run Text="{Binding ApplicationCount, Mode=OneWay}" />
                    <Run Text=" 个应用 · " />
                    <Run Text="{Binding BackgroundCount, Mode=OneWay}" />
                    <Run Text=" 个后台进程" />
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RunNewTaskCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="36"
                        AutomationProperties.Name="运行新任务"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,4 V20 M4,12 H20"
                              Width="11"
                              Height="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBlock Text="运行新任务" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EndTaskCommand}"
                        Style="{StaticResource DangerGhostButtonStyle}"
                        Height="36"
                        AutomationProperties.Name="结束任务">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconClose}"
                              Width="9"
                              Height="9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBlock Text="结束任务" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,17,0,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Height="34"
                             Padding="35,0"
                             AutomationProperties.Name="搜索进程"
                             Tag="按名称、PID 或发布者搜索"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Data="{StaticResource IconSearch}"
                          Width="14"
                          Height="14"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="13,0,0,0"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          IsHitTestVisible="False" />
                </Grid>

                <ListBox ItemsSource="{Binding ProcessFilters}"
                         SelectedItem="{Binding SelectedProcessFilter, Mode=TwoWay}"
                         AutomationProperties.Name="进程类型筛选"
                         Style="{StaticResource FilterChipListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}"
                                           FontSize="11.5"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceInsetBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="0,0,7,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="32"
                        Height="32"
                        Command="{Binding RefreshCommand}"
                        ToolTip="刷新进程列表"
                        AutomationProperties.Name="刷新进程列表">
                    <Path Data="{StaticResource IconRefresh}"
                          Width="14"
                          Height="14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="32"
                        Height="32"
                        Command="{Binding TogglePauseCommand}"
                        ToolTip="{Binding PauseButtonText}"
                        AutomationProperties.Name="{Binding PauseButtonText}">
                    <Path Data="{StaticResource IconPause}"
                          Width="13"
                          Height="13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Process table -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="ProcessGrid"
                          ItemsSource="{Binding ProcessView}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGridStyle}"
                          Margin="0,4,0,0"
                          MouseDoubleClick="ProcessGrid_MouseDoubleClick"
                          AutomationProperties.Name="进程列表">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="进程名称"
                                                Width="*"
                                                MinWidth="250"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                                            <Border Background="{Binding AvatarBrush}" CornerRadius="7" />
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding IconSource}"
                                                   Width="20"
                                                   Height="20"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Data="{StaticResource IconShield}"
                                                      Width="10"
                                                      Height="10"
                                                      Margin="6,0,0,0"
                                                      Stroke="{DynamicResource WarningBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      ToolTip="受保护的系统进程"
                                                      Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CPU"
                                                Width="82"
                                                SortMemberPath="CpuPercent"
                                                HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource NumericCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="内存"
                                                Width="102"
                                                SortMemberPath="MemoryMb"
                                                HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource NumericCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="磁盘"
                                                Width="105"
                                                SortMemberPath="DiskMbPerSecond"
                                                HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource NumericCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="PID"
                                                Width="76"
                                                SortMemberPath="Pid"
                                                HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pid}" Style="{StaticResource NumericCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="类型"
                                                Width="88"
                                                SortMemberPath="KindText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource KindPillStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="{x:Type Ellipse}">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding KindText}" Value="应用">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding KindText}" Value="系统">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding KindText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="0" Panel.ZIndex="4" IsHitTestVisible="False" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProcessView.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource SurfaceInsetBrush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}"
                                  Width="18"
                                  Height="18"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="没有匹配的进程"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="尝试更换关键词或进程类型筛选。"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Grid Width="28" Height="28" Margin="0,0,9,0">
                                <Ellipse Fill="{DynamicResource AccentSoftBrush}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProcessName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedProcessDescription}"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="双击查看详情"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,13,0" />
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    Command="{Binding OpenProcessLocationCommand}"
                                    ToolTip="打开文件位置"
                                    AutomationProperties.Name="打开文件位置">
                                <Path Data="{StaticResource IconFolder}"
                                      Width="14"
                                      Height="14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" />
                            </Button>
                            <Button Content="结束进程树"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="32"
                                    Foreground="{DynamicResource DangerBrush}"
                                    Command="{Binding EndTreeCommand}"
                                    Margin="3,0,0,0" />
                            <Button Content="详细信息"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32"
                                    Padding="13,0"
                                    Command="{Binding ShowDetailsCommand}"
                                    Margin="4,0,7,0" />
                            <Button Content="结束任务"
                                    Style="{StaticResource DangerGhostButtonStyle}"
                                    Height="32"
                                    Command="{Binding EndTaskCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
