<UserControl x:Class="HWZ.TaskManager.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HWZ.TaskManager.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="TopProcessButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RowBackground"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="8,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,10,0,14">

            <!-- Page header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="设备状态、资源趋势与高占用进程，一屏掌握。"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Busy">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Busy">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HealthTitle}" FontSize="10.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Busy">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceInsetBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDot}"
                                  Width="8"
                                  Height="8"
                                  Fill="{DynamicResource TextTertiaryBrush}"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="已运行 " />
                                <Run Text="{Binding UptimeText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Primary metrics -->
            <Grid MinHeight="232">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.06*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="处理器" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="CPU" HorizontalAlignment="Right" Style="{StaticResource SectionLabelStyle}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="118" Height="118" VerticalAlignment="Center">
                                <controls:RingGauge Value="{Binding CpuUsage}"
                                                    AccentBrush="{DynamicResource AccentBrush}"
                                                    TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                    StrokeThickness="8.5" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0}}"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="% 使用率"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,-1,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="17,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuNameText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="31"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CpuNameText}" />
                                <TextBlock Text="{Binding CpuSubtitleText}"
                                           FontSize="9.8"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CpuSubtitleText}" />

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,9" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="进程" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding ProcessCount}"
                                               HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="线程" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding ThreadsText}"
                                               HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="句柄" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding HandlesText}"
                                               HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Memory -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource VioletBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="内存" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="RAM" HorizontalAlignment="Right" Style="{StaticResource SectionLabelStyle}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="118" Height="118" VerticalAlignment="Center">
                                <controls:RingGauge Value="{Binding MemoryUsagePercent}"
                                                    AccentBrush="{DynamicResource VioletBrush}"
                                                    TrackBrush="{DynamicResource GaugeTrackBrush}"
                                                    StrokeThickness="8.5" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}}"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="% 使用中"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,-1,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="17,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="已用内存"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding MemoryUsedText}">
                                    <Run Text="{Binding MemoryUsedText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="共 " />
                                    <Run Text="{Binding MemoryTotalText, Mode=OneWay}" />
                                </TextBlock>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,9" />

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="可用" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding MemoryAvailableText}"
                                               HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding MemoryAvailableText}" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="已提交" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding CommitUsedText}"
                                               HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CommitText}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="应用 / 后台" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold">
                                        <Run Text="{Binding ApplicationCount, Mode=OneWay}" />
                                        <Run Text="/" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <Run Text="{Binding BackgroundCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Device health -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthState}" Value="Busy">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="设备状态" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MachineText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="{Binding HealthTitle}" FontSize="20" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Busy">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthState}" Value="Critical">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HealthDescription}"
                                       FontSize="10.5"
                                       LineHeight="16"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Row="2" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13,0,11" />

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="操作系统" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding OsDisplayText}"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="168"
                                           ToolTip="{Binding OsDisplayText}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="处理器" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding CpuNameText}"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="168"
                                           ToolTip="{Binding CpuNameText}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="设备型号" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding SystemModelText}"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="168"
                                           ToolTip="{Binding SystemModelText}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="运行时间" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding UptimeText}"
                                           HorizontalAlignment="Right"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Trend + storage -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="18">
                    <Grid MinHeight="205">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="性能趋势" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="处理器与内存使用率变化"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:0.0}%}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource VioletBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="内存" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0.0}%}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <controls:SparklineChart Grid.Row="1"
                                                 Height="116"
                                                 Margin="0,14,0,8"
                                                 VerticalAlignment="Bottom"
                                                 Values="{Binding CpuHistory}"
                                                 Values2="{Binding MemoryHistory}"
                                                 AccentBrush="{DynamicResource AccentBrush}"
                                                 Accent2Brush="{DynamicResource VioletBrush}"
                                                 GridBrush="{DynamicResource ChartGridBrush}"
                                                 ShowFill="True"
                                                 MinimumRange="20" />

                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding HistoryWindowText}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RefreshRateText}"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text=" · 实时采样"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="存储与网络" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding OverallDiskUsedPercentText}"
                                       HorizontalAlignment="Right"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <ProgressBar Style="{StaticResource ThinProgressBarStyle}"
                                         Value="{Binding OverallDiskUsedPercent, Mode=OneWay}"
                                         Maximum="100"
                                         Foreground="{DynamicResource AccentBrush}" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{Binding OverallDiskUsedText}"
                                           FontSize="9.8"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="总体磁盘使用"
                                           HorizontalAlignment="Right"
                                           FontSize="9.8"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Volumes}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UsedPercentText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconArrowDown}"
                                              Width="11"
                                              Height="11"
                                              Stroke="{DynamicResource SuccessBrush}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />
                                        <TextBlock Text="下载"
                                                   FontSize="9.8"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding NetworkDownText}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconArrowUp}"
                                              Width="11"
                                              Height="11"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0" />
                                        <TextBlock Text="上传"
                                                   FontSize="9.8"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding NetworkUpText}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ActiveNetworkName}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Top processes -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="18,16,18,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="资源占用最高" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="按处理器使用率排序的进程"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="查看全部进程"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding ShowAllProcessesCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="8,12,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进程" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="CPU" HorizontalAlignment="Right" Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="内存" HorizontalAlignment="Right" Style="{StaticResource SectionLabelStyle}" />
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TopProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TopProcessButtonStyle}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.InspectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                <Border Background="{Binding AvatarBrush}" CornerRadius="7" />
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding IconSource}"
                                                       Width="20"
                                                       Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <ProgressBar Style="{StaticResource ThinProgressBarStyle}"
                                                         Value="{Binding CpuPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         Width="52"
                                                         Height="3"
                                                         HorizontalAlignment="Right"
                                                         Margin="0,4,0,0"
                                                         Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MemoryText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
