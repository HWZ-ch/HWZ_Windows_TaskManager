<UserControl x:Class="HWZ.TaskManager.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RightHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="12,0,15,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="服务" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding ServiceSummaryText}"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Height="36"
                        AutomationProperties.Name="打开服务管理器"
                        Command="{Binding OpenServicesConsoleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconExternal}"
                              Width="12"
                              Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                        <TextBlock Text="打开服务管理器" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,17,0,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="300" Margin="0,0,14,0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Height="34"
                             Padding="35,0"
                             AutomationProperties.Name="搜索服务"
                             Tag="搜索服务名称或描述"
                             Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Data="{StaticResource IconSearch}"
                          Width="14"
                          Height="14"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="13,0,0,0"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          IsHitTestVisible="False" />
                </Grid>

                <ListBox ItemsSource="{Binding ServiceFilters}"
                         SelectedItem="{Binding SelectedServiceFilter, Mode=TwoWay}"
                         AutomationProperties.Name="服务状态筛选"
                         Style="{StaticResource FilterChipListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="11.5"
                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="正在读取服务…"
                           FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Visibility="{Binding IsLoadingServices, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource IconButtonStyle}"
                        Width="32"
                        Height="32"
                        Command="{Binding RefreshServicesManuallyCommand}"
                        ToolTip="刷新服务列表"
                        AutomationProperties.Name="刷新服务列表">
                    <Path Data="{StaticResource IconRefresh}"
                          Width="14"
                          Height="14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Service table -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding ServicesView}"
                          Style="{StaticResource ModernDataGridStyle}"
                          RowHeight="58"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="Windows 服务列表">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="服务名称"
                                                Width="*"
                                                MinWidth="310"
                                                SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                                            <Border Background="{Binding AvatarBrush}" CornerRadius="7" Opacity="0.92" />
                                            <Path Data="{StaticResource IconSettingsSliders}"
                                                  Width="13"
                                                  Height="13"
                                                  Stroke="White"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShortDescription}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       ToolTip="{Binding Description}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="状态" Width="112" SortMemberPath="IsRunning">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="Running">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="Stopped">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="StartPending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusCode}" Value="StopPending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="{x:Type Ellipse}">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="Running">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="StartPending">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="StopPending">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="Running">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="StartPending">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="StopPending">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="启动类型" Width="120" SortMemberPath="StartupType">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartupType}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="操作" Width="166">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="启动"
                                                Height="27"
                                                Padding="12,0"
                                                FontSize="10"
                                                IsEnabled="{Binding CanStart}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="停止"
                                                Height="27"
                                                Padding="12,0"
                                                FontSize="10"
                                                IsEnabled="{Binding CanStop}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <TextBlock Text="{Binding ServiceSummaryText}"
                                   FontSize="9.8"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconShield}"
                                  Width="11"
                                  Height="11"
                                  Stroke="{DynamicResource WarningBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="更改系统服务需要管理员权限，请谨慎操作。"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
