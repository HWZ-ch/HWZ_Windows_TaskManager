<Window x:Class="HWZ.TaskManager.Dialogs.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HWZ 任务管理器"
        Width="520"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid Margin="28">
        <Border x:Name="DialogCard"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="0.42"
                                  ShadowDepth="12"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderArea"
                      Margin="24,22,16,0"
                      Background="Transparent"
                      MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBackground"
                            Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <Path x:Name="DialogIcon"
                              Width="20"
                              Height="20"
                              Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 M12,8 V13 M12,16.6 V17"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,1,12,0">
                        <TextBlock x:Name="TitleText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="HWZ TASK MANAGER"
                                   Margin="0,5,0,0"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Opacity="0.8" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭"
                            Click="CloseButton_Click"
                            VerticalAlignment="Top">
                        <Path Data="{StaticResource IconClose}"
                              Width="10"
                              Height="10"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="470"
                              Margin="24,18,24,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="MessageText"
                                   FontSize="13"
                                   LineHeight="21"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel x:Name="PromptPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="命令"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="2,0,0,7" />
                            <TextBox x:Name="InputBox"
                                     Height="42"
                                     AutomationProperties.Name="要运行的命令"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Tag="例如：notepad.exe 或 cmd.exe /k"
                                     VerticalContentAlignment="Center"
                                     Padding="13,0" />
                            <Grid x:Name="AdminPanel" Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RunAsAdminCheck"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          AutomationProperties.Name="以管理员身份运行"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Text="以管理员身份运行"
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="适用于需要更高权限的程序或命令"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border x:Name="DetailsPanel"
                                Visibility="Collapsed"
                                Margin="0,18,0,0"
                                Background="{DynamicResource SurfaceInsetBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="16,15,16,4">
                            <ItemsControl x:Name="DetailsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="122" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Height="1"
                        Margin="24,20,24,0"
                        Background="{DynamicResource DividerBrush}" />

                <Grid Grid.Row="3" Margin="24,18,24,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="按 Esc 关闭"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               Opacity="0.8" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SecondaryButton"
                                Content="取消"
                                MinWidth="88"
                                Height="38"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SecondaryButton_Click" />
                        <Button x:Name="PrimaryButton"
                                Content="确定"
                                MinWidth="96"
                                Height="38"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="PrimaryButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
